<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>줄에 매달려 정지한 풍경 · 힘의 평형</title>
<style>
@font-face{font-family:'Noto Sans KR';font-style:normal;font-weight:400;font-display:swap;src:url(data:font/woff2;base64,) format('woff2');}
@font-face{font-family:'Noto Sans KR';font-style:normal;font-weight:500;font-display:swap;src:url(data:font/woff2;base64,) format('woff2');}
@font-face{font-family:'Noto Sans KR';font-style:normal;font-weight:600;font-display:swap;src:url(data:font/woff2;base64,) format('woff2');}
@font-face{font-family:'Noto Sans KR';font-style:normal;font-weight:700;font-display:swap;src:url(data:font/woff2;base64,) format('woff2');}
</style>
<style>
:root{
  --primary:#0066CC;
  --primary-dark:#2997FF;
  --ink:#1D1D1F;
  --muted:#7A7A7A;
  --canvas-bg:#FFFFFF;
  --parchment:#F5F5F7;
  --pearl:#FAFAFC;
  --hairline:#E0E0E0;
  --force1:#FF3B30;
  --force2:#0066CC;
  --radius-lg:16px;
  --radius-pill:999px;
  color-scheme: light;
}
*{box-sizing:border-box;}
html,body{margin:0;padding:0;}
body{
  font-family:'Noto Sans KR','Noto Sans CJK KR','Inter',-apple-system,BlinkMacSystemFont,'Apple SD Gothic Neo','Malgun Gothic','Segoe UI',Roboto,sans-serif;
  background:var(--parchment);
  color:var(--ink);
  min-height:100vh;
  display:flex;
  justify-content:center;
  padding:28px 16px 60px;
}
.wrap{width:100%;max-width:760px;}
.badge-row{display:flex;align-items:center;gap:10px;margin-bottom:6px;}
.badge{
  display:inline-flex;align-items:center;justify-content:center;
  background:var(--primary);color:#fff;
  font-size:13px;font-weight:600;letter-spacing:0;
  padding:6px 14px;border-radius:var(--radius-pill);
  white-space:nowrap;
}
.unit-tag{font-size:14px;color:var(--muted);font-weight:400;}
h1{font-size:28px;font-weight:600;margin:6px 0 2px;letter-spacing:-0.01em;}
p.sub{font-size:17px;color:var(--muted);margin:0 0 20px;line-height:1.55;}
.card{
  background:var(--canvas-bg);
  border:1px solid var(--hairline);
  border-radius:var(--radius-lg);
  padding:18px;
  margin-bottom:16px;
}
.stage{
  position:relative;width:100%;aspect-ratio:8/5;
  background:var(--pearl);border-radius:12px;overflow:hidden;
  border:1px solid var(--hairline);
  touch-action:none;
}
.stage canvas{
  position:absolute;inset:0;width:100%;height:100%;display:block;cursor:crosshair;
}
.status{
  margin-top:12px;font-size:18px;font-weight:600;color:var(--ink);
  display:flex;align-items:center;gap:8px;min-height:24px;
}
.status .dot{width:9px;height:9px;border-radius:50%;background:var(--primary);flex:none;}
.force-rows{display:flex;flex-direction:column;gap:10px;margin-top:14px;}
.force-row{
  display:flex;align-items:center;gap:12px;
  border:1.5px solid var(--hairline);border-radius:12px;
  padding:12px 14px;cursor:pointer;background:var(--pearl);
  transition:border-color .15s;
}
.force-row.active{border-color:var(--force-color,var(--primary));background:#fff;}
.swatch{width:22px;height:22px;border-radius:50%;flex:none;}
.force-row input{
  flex:1;border:none;background:transparent;font-size:18px;font-family:inherit;
  color:var(--ink);outline:none;min-width:0;
}
.force-row input::placeholder{color:#B0B0B5;}
.force-row .mark{font-size:15px;color:var(--muted);font-weight:600;min-width:44px;}
.controls-bottom{display:flex;flex-wrap:wrap;gap:10px;margin-top:18px;align-items:center;}
.name-field{
  display:flex;align-items:center;gap:8px;border:1.5px solid var(--hairline);
  border-radius:var(--radius-pill);padding:10px 16px;background:var(--pearl);flex:1;min-width:180px;
}
.name-field input{border:none;background:transparent;font-size:17px;font-family:inherit;outline:none;width:100%;color:var(--ink);}
.name-field label{font-size:15px;color:var(--muted);font-weight:600;white-space:nowrap;}
button{
  font-family:inherit;font-size:17px;font-weight:600;border:none;cursor:pointer;
  border-radius:var(--radius-pill);padding:13px 24px;
}
.btn-primary{background:var(--primary);color:#fff;}
.btn-primary:active{background:#0052A3;}
.btn-ghost{background:transparent;color:var(--muted);border:1.5px solid var(--hairline);padding:11px 20px;font-size:16px;}
.hint{font-size:14.5px;color:var(--muted);margin-top:10px;line-height:1.6;}
@media (max-width:480px){
  h1{font-size:22px;}
  .controls-bottom{flex-direction:column;align-items:stretch;}
  .name-field{min-width:0;}
}
</style>
</head>
<body>
<div class="wrap">
  <div class="badge-row">
    <span class="badge">사례 ③</span>
    <span class="unit-tag">Ⅴ. 힘의 작용 · 힘의 평형 관계</span>
  </div>
  <h1>줄에 매달려 정지한 풍경</h1>
  <p class="sub">풍경(바람에 흔들리는 종)이 줄에 매달린 채 가만히 정지해 있어요. 이 풍경에 작용하는 두 힘을 화살표로 표시해 보세요.</p>

  <div class="card">
    <div class="stage"><canvas id="c" width="800" height="500"></canvas></div>
    <div class="status" id="status"><span class="dot"></span>힘 1 — 화살표가 시작하는 점(점선 원 근처)을 클릭하세요</div>
    <div class="force-rows">
      
    <div class="force-row active" data-force="1" style="--force-color:#FF3B30">
      <div class="swatch" style="background:#FF3B30"></div>
      <span class="mark">힘 1</span>
      <input type="text" class="force-label" data-force="1" placeholder="힘 1의 이름을 입력하세요" />
    </div>
      
    <div class="force-row" data-force="2" style="--force-color:#0066CC">
      <div class="swatch" style="background:#0066CC"></div>
      <span class="mark">힘 2</span>
      <input type="text" class="force-label" data-force="2" placeholder="힘 2의 이름을 입력하세요" />
    </div>
    </div>
    <div class="controls-bottom">
      <button class="btn-ghost" id="reset">다시 그리기</button>
      <div class="name-field">
        <label for="student-name">이름</label>
        <input id="student-name" type="text" placeholder="여기에 이름을 입력하세요" />
      </div>
      <button class="btn-primary" id="save">이미지로 저장</button>
    </div>
    <p class="hint">시작점을 클릭하고 끝점을 클릭하면 화살표가 그려져요. 저장하면 이 화면이 사진(PNG)으로 다운로드돼요 — 그 사진을 패들렛의 우리 모둠 칸에 내 이름으로 올려주세요.</p>
  </div>
</div>
<script>

var sceneImg3 = new Image();
sceneImg3.onload = function(){ if(window.__rerenderScene) window.__rerenderScene(); };
sceneImg3.src = 'data:image/png;base64,';

function drawScene(ctx, W, H){

  ctx.fillStyle = '#F5F5F7'; ctx.fillRect(0,0,W,H);
  // ceiling band for context
  ctx.fillStyle = '#E3E3E7'; ctx.fillRect(0,40,W,18);
  ctx.strokeStyle = '#CCCCD1'; ctx.lineWidth=2;
  ctx.beginPath(); ctx.moveTo(0,58); ctx.lineTo(W,58); ctx.stroke();
  if(sceneImg3.complete && sceneImg3.naturalWidth){
    var iw = sceneImg3.naturalWidth, ih = sceneImg3.naturalHeight;
    var maxH = 430, maxW = 260;
    var scale = Math.min(maxW/iw, maxH/ih);
    var dw = iw*scale, dh = ih*scale;
    var dx = W/2 - dw/2, dy = 58;
    ctx.drawImage(sceneImg3, dx, dy, dw, dh);
  }

}

(function(){
  var canvas = document.getElementById('c');
  var ctx = canvas.getContext('2d');
  var W = canvas.width, H = canvas.height;
  var status = document.getElementById('status');
  var forces = {1:{p1:null,p2:null,color:'#FF3B30',label:''}, 2:{p1:null,p2:null,color:'#0066CC',label:''}};
  var current = 1;
  var centerHint = {x:400,y:280};

  function drawArrowhead(x1,y1,x2,y2,color){
    var angle = Math.atan2(y2-y1, x2-x1);
    var len = 16;
    ctx.beginPath();
    ctx.moveTo(x2,y2);
    ctx.lineTo(x2-len*Math.cos(angle-Math.PI/7), y2-len*Math.sin(angle-Math.PI/7));
    ctx.lineTo(x2-len*Math.cos(angle+Math.PI/7), y2-len*Math.sin(angle+Math.PI/7));
    ctx.closePath();
    ctx.fillStyle = color;
    ctx.fill();
  }

  function drawArrow(f){
    if(!f.p1 || !f.p2) return;
    ctx.save();
    ctx.strokeStyle = f.color; ctx.fillStyle = f.color;
    ctx.lineWidth = 5; ctx.lineCap='round';
    ctx.beginPath();
    ctx.moveTo(f.p1.x, f.p1.y);
    ctx.lineTo(f.p2.x, f.p2.y);
    ctx.stroke();
    drawArrowhead(f.p1.x, f.p1.y, f.p2.x, f.p2.y, f.color);
    ctx.beginPath();
    ctx.arc(f.p1.x, f.p1.y, 5, 0, Math.PI*2);
    ctx.fill();
    if(f.label){
      ctx.font = "600 20px 'Noto Sans KR', 'Noto Sans CJK KR', sans-serif";
      var tx = f.p2.x, ty = f.p2.y;
      var pad = 6;
      var tw = ctx.measureText(f.label).width;
      var lx = tx + 10, ly = ty - 10;
      if(lx + tw + pad*2 > W) lx = tx - tw - 26;
      if(ly < 22) ly = ty + 26;
      ctx.fillStyle = 'rgba(255,255,255,0.92)';
      ctx.fillRect(lx-pad, ly-20, tw+pad*2, 26);
      ctx.strokeStyle = f.color; ctx.lineWidth=1.5;
      ctx.strokeRect(lx-pad, ly-20, tw+pad*2, 26);
      ctx.fillStyle = f.color;
      ctx.fillText(f.label, lx, ly);
    }
    ctx.restore();
  }

  function render(){
    ctx.clearRect(0,0,W,H);
    drawScene(ctx, W, H);
    ctx.save();
    ctx.setLineDash([4,4]);
    ctx.strokeStyle = 'rgba(0,102,204,0.35)';
    ctx.lineWidth = 1.5;
    ctx.beginPath();
    ctx.arc(centerHint.x, centerHint.y, 6, 0, Math.PI*2);
    ctx.stroke();
    ctx.restore();
    drawArrow(forces[1]);
    drawArrow(forces[2]);
    if(pending){
      ctx.save();
      ctx.fillStyle = forces[current].color;
      ctx.beginPath(); ctx.arc(pending.x, pending.y, 5, 0, Math.PI*2); ctx.fill();
      ctx.restore();
    }
    updateStatus();
  }

  var pending = null;

  function updateStatus(){
    var f = forces[current];
    if(pending){
      status.textContent = '힘 ' + current + ' — 화살표가 끝나는 점을 클릭하세요';
    } else if(!f.p1){
      status.textContent = '힘 ' + current + ' — 화살표가 시작하는 점(점선 원 근처)을 클릭하세요';
    } else {
      status.textContent = '힘 ' + current + ' 표시 완료 · 다른 힘을 눌러 이어서 표시하세요';
    }
  }

  function getPos(evt){
    var rect = canvas.getBoundingClientRect();
    var scaleX = W / rect.width, scaleY = H / rect.height;
    return { x:(evt.clientX-rect.left)*scaleX, y:(evt.clientY-rect.top)*scaleY };
  }

  canvas.addEventListener('click', function(evt){
    var pos = getPos(evt);
    if(!pending){
      pending = pos;
    } else {
      forces[current].p1 = pending;
      forces[current].p2 = pos;
      pending = null;
      var other = current === 1 ? 2 : 1;
      if(!forces[other].p1) current = other;
    }
    render();
  });

  document.querySelectorAll('.force-row').forEach(function(row){
    row.addEventListener('click', function(e){
      if(e.target.tagName === 'INPUT') return;
      current = parseInt(row.getAttribute('data-force'));
      pending = null;
      document.querySelectorAll('.force-row').forEach(function(r){r.classList.remove('active');});
      row.classList.add('active');
      render();
    });
  });

  document.querySelectorAll('.force-label').forEach(function(inp){
    inp.addEventListener('input', function(){
      var n = parseInt(inp.getAttribute('data-force'));
      forces[n].label = inp.value;
      render();
    });
    inp.addEventListener('focus', function(){
      current = parseInt(inp.getAttribute('data-force'));
      pending = null;
      document.querySelectorAll('.force-row').forEach(function(r){r.classList.remove('active');});
      inp.closest('.force-row').classList.add('active');
    });
  });

  document.getElementById('reset').addEventListener('click', function(){
    forces[1].p1=null; forces[1].p2=null;
    forces[2].p1=null; forces[2].p2=null;
    pending=null; current=1;
    document.querySelectorAll('.force-label').forEach(function(i){});
    document.querySelectorAll('.force-row').forEach(function(r,idx){r.classList.toggle('active', idx===0);});
    render();
  });

  document.getElementById('save').addEventListener('click', function(){
    var nameEl = document.getElementById('student-name');
    var name = nameEl.value.trim();
    var footerH = 56;
    var out = document.createElement('canvas');
    out.width = W; out.height = H + footerH;
    var octx = out.getContext('2d');
    octx.fillStyle = '#FFFFFF';
    octx.fillRect(0,0,W,H+footerH);
    octx.drawImage(canvas, 0, 0);
    octx.fillStyle = '#1D1D1F';
    octx.font = "600 22px 'Noto Sans KR', 'Noto Sans CJK KR', sans-serif";
    octx.fillText('사례③ 줄에 매달려 정지한 풍경', 20, H+36);
    if(name){
      octx.font = "400 20px 'Noto Sans KR', 'Noto Sans CJK KR', sans-serif";
      octx.fillStyle = '#7A7A7A';
      var nw = octx.measureText(name).width;
      octx.fillText(name, W-nw-20, H+36);
    }
    var link = document.createElement('a');
    var fname = '522_사례3_중력과장력' + (name ? '_'+name : '') + '.png';
    link.download = fname;
    link.href = out.toDataURL('image/png');
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
  });

  render();
  window.__rerenderScene = render;
})();

</script>
</body>
</html>
